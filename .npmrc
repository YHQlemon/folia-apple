# 允许根 package.json 明确声明的远程 tarball。
allow-remote=root
registry=https://registry.npmjs.org/
replace-registry-host=never

# onnxruntime-node 的 postinstall 只在 linux/x64 上有活干：去 NuGet 源下载 CUDA 12 与
# TensorRT 的执行提供器（见 script/install-metadata.js 的 requirements 表，其余平台都是空）。
# 本项目只申请 webgpu，失败退回 cpu（electron/analysis/worker.cjs 的 PROVIDERS），从不申请
# cuda，所以那批 .so 下下来也永远不会被加载。跳过它，CI 的 npm ci 才不会挂在一次连不上的下载上。
onnxruntime-node-install=skip

# 本机用 pnpm 安装依赖时的本地布局：pnpm 默认的符号链接布局在这台机器的深层依赖树上会
# 直接栈溢出（ERR_PNPM_SYMLINK_FAILED: Maximum call stack size exceeded），换成提升式
# node_modules 才能装完。npm ci 不读这一项，仓库原有流程不受影响。
node-linker=hoisted
